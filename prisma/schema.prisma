generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model cliente {
  id       Int    @id @default(autoincrement())
  nome     String
  email    String @unique
  cpf      String @unique
  telefone String @unique

animais Animal[]

  criadoEm DateTime @default(now())

  @@map("clientes")
}

model Animal {
  id             Int      @id @default(autoincrement())
  nome           String
  raca           String
  especie        String
  datanascimento DateTime
  selvagem        Boolean @default(false)
  registroLegal    String?
  porte        String?  @default("Médio")
   clienteId      Int
  cliente cliente @relation(fields: [clienteId],references: [id])

    consultas Consulta[]

  @@map("animais")
}

model Veterinario {
  id            Int    @id @default(autoincrement())
  nome          String
  crmv          String @unique
  especialidade String
  email         String @unique

    consultas Consulta[]

  @@map("veterinarios")
}

model CategoriaConsulta {
  id            Int      @id @default(autoincrement())
  nomeCategoria String
  valorConsulta Float

  consultas Consulta[]

  @@map("categorias_consultas")
}

model Consulta {
  id            Int      @id @default(autoincrement())
  categoriaId   Int
  animalId      Int
  veterinarioId Int
  dataHorario   DateTime
  status        String   @default("Agendada")

  domiciliar  Boolean  @default(false)
  categoria  CategoriaConsulta @relation(fields: [categoriaId], references: [id])
  animal     Animal            @relation(fields: [animalId], references: [id])
  veterinario Veterinario      @relation(fields: [veterinarioId], references: [id])

  prontuario Prontuario?
  @@unique([veterinarioId, dataHorario])
  @@map("consultas")
}


model Prontuario {
  id          Int    @id @default(autoincrement())
   consultaId  Int       @unique
  diagnostico String?
  prescricao  String?
  dataRetorno DateTime?


  consulta Consulta @relation(fields: [consultaId], references: [id], onDelete: Cascade)
  @@map("prontuarios")
}
